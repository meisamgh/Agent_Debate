# Copy this file to .env and fill in tokens locally.
# Never commit real API keys.
JUSTWOKER_API_KEY=

# Optional: required only when running with --research.
TAVILY_API_KEY=

ARCH_COUNCIL_BASE_URL=https://api.justwoker.icu
ARCHITECT_A_MODEL=gpt-5.6-sol
ARCHITECT_B_MODEL=gpt-5.6-terra
ARCHITECT_C_MODEL=gpt-5.6-luna
ARCH_COUNCIL_TIMEOUT_SECONDS=180
