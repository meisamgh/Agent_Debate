# Copy this file to .env and fill in tokens locally.
# Never commit real API keys.
JUSTWOKER_API_KEY=

# Free/keyless research provider. Run SearXNG locally or point this at your instance.
SEARXNG_URL=http://localhost:8080
# Optional for local-only use; replace this before exposing SearXNG beyond localhost.
SEARXNG_SECRET=change-me-local-only

# Optional: needed only with --research-provider tavily.
TAVILY_API_KEY=

ARCH_COUNCIL_BASE_URL=https://api.justwoker.icu
ARCHITECT_A_MODEL=gpt-5.6-sol
ARCHITECT_B_MODEL=gpt-5.6-terra
ARCHITECT_C_MODEL=gpt-5.6-luna
ARCH_COUNCIL_TIMEOUT_SECONDS=180
